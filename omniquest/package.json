{
  "name": "omniquest",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:source && npm run test:unit",
    "test:source": "node --test tests/source/*.test.mjs",
    "test:db": "supabase test db",
    "test:security": "npm run test:source && npm run test:db",
    "types:supabase": "supabase gen types typescript --linked --schema public > types/database.types.ts",
    "deploy:push": "supabase functions deploy send-push-notification && supabase functions deploy teacher-student-reminder && supabase functions deploy process-notification-delivery --no-verify-jwt",
    "deploy:operations": "supabase functions deploy process-notification-delivery --no-verify-jwt && supabase functions deploy process-teacher-digests --no-verify-jwt && supabase functions deploy process-support-email-delivery --no-verify-jwt",
    "deploy:security": "supabase functions deploy manage-account-security",
    "deploy:media": "supabase functions deploy process-question-media && supabase functions deploy cleanup-question-media --no-verify-jwt",
    "audit:design-system": "node scripts/audit-design-system.mjs",
    "audit:accessibility": "node scripts/audit-accessibility-responsive.mjs",
    "deploy:auth": "supabase functions deploy auth-attempt-guard --no-verify-jwt",
    "test:auth-forms": "node --test tests/source/auth-public-flows.behavior.test.mjs",
    "deploy:audit-exports": "supabase functions deploy process-teacher-audit-exports --no-verify-jwt",
    "deploy:support-email": "supabase functions deploy process-support-email-delivery --no-verify-jwt",
    "deploy:admin-exports": "supabase functions deploy process-admin-export-jobs --no-verify-jwt",
    "quality:install": "node scripts/install-quality-tooling.mjs",
    "test:unit": "jest --runInBand",
    "test:unit:watch": "jest --watch",
    "test:migrations": "node scripts/validate-migrations.mjs",
    "test:functions": "deno test --allow-env supabase/functions/_shared/*_test.ts",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test e2e/web/visual.spec.ts",
    "test:quality": "npm run test:source && npm run test:unit && npm run test:migrations && npm run test:functions",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "build:web": "expo export --platform web",
    "docs:generate": "node scripts/generate-backend-catalog.mjs",
    "docs:check": "node scripts/generate-backend-catalog.mjs --check",
    "deploy:functions": "node scripts/deploy-edge-functions.mjs",
    "demo:prepare": "node scripts/prepare-authenticated-demo.mjs",
    "demo:diagnose-auth": "node scripts/diagnose-local-auth.mjs",
    "demo:verify": "node scripts/verify-authenticated-demo.mjs",
    "demo:verify:after": "node scripts/verify-authenticated-demo.mjs --after",
    "audit:walkthrough": "node scripts/audit-authenticated-walkthrough.mjs --check",
    "audit:walkthrough:generate": "node scripts/audit-authenticated-walkthrough.mjs --write",
    "demo:prepare-functions-env": "node scripts/prepare-local-function-env.mjs",
    "demo:process-workers": "node scripts/process-demo-workers.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/pacifico": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.104.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true
}
