{
  "expo": {
    "name": "OmniQuest",
    "slug": "omniquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "omniquest",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexalbert.omniquest"
    },
    "android": {
      "package": "com.alexalbert.omniquest",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050E1F",
          "dark": {
            "backgroundColor": "#050E1F"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#09acf4",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "OmniQuest necesita acceso a tu galería para seleccionar imágenes y vídeos que decidas adjuntar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a101ffdd-7979-4835-a6cc-de59b847591b"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#050E1F",
      "barStyle": "light-content"
    }
  }
}
